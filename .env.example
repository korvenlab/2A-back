# Backend 2AVendas — variáveis de ambiente (sem valores)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
# Opcional: domínio canónico só para links (cortesia, /billing/unlock, success_url Stripe).
# Se FRONTEND_ORIGIN tiver "vercel.app,2avendas.com" para CORS, defina isto como https://2avendas.com
PUBLIC_APP_ORIGIN=

# Resend SMTP (Auth Supabase — recuperação de senha). Painel hospedado: Authentication → Email → SMTP.
# Host smtp.resend.com, port 465, user resend, password = API key Resend.
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_USER=resend
RESEND_SMTP_PASS=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Stripe (nunca commitar chaves reais)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Korven Dashboard — liberação manual
# Mesmo segredo: POST /api/billing/organization-access (JSON unlock) OU POST /api/billing/organization-access-link (retorna unlock_url estilo Wagoo).
KORVEN_BILLING_ADMIN_SECRET=

# Korven control plane (opcional; sem URL ou segredo o publisher fica em no-op)
DASHBOARD_INGEST_URL=
TWO_AVENDAS_DASHBOARD_INGEST_SECRET=
# Timeout por tentativa e retries adicionais (defaults: 4000 e 2)
DASHBOARD_INGEST_TIMEOUT_MS=4000
DASHBOARD_INGEST_RETRIES=2
